{
  "name": "mini-erp-vault-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:https": "node scripts/dev.mjs --https",
    "nginx:dev": "node scripts/render-nginx.mjs",
    "build": "max build",
    "preview": "max preview --port 8002",
    "setup": "max setup",
    "lint": "biome lint . && tsc --noEmit",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "antd:lint": "antd lint ./src --format json"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.2",
    "@umijs/max": "4.6.75",
    "antd": "6.5.1",
    "hash-wasm": "4.12.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@ant-design/cli": "6.5.1",
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "1.61.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
