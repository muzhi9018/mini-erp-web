{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "paths": { "@/*": ["./src/*"], "@@/*": ["./src/.umi/*"] }
  },
  "include": ["src", "config", "tests", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
