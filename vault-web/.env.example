# 生产构建的 HTTPS 接口地址，可包含网关路径；末尾斜杠会自动去除。
# 必须显式配置，留空表示使用同源代理。真实地址仅填写在 .env.local 或运行环境中。
VAULT_API_BASE_URL=

# 以下仅用于本地开发；生产打包不需要开发域名或本机证书。
# 复制为 .env.local，并填写开发环境后端代理目标地址。
# 地址需包含上游服务器要求的网关路径。
VAULT_API_TARGET=
# NGINX 开发站点的完整 HTTPS Origin，无路径、查询参数或末尾斜杠。
VAULT_DEV_ORIGIN=
# NGINX 证书和私钥的本地路径。
VAULT_NGINX_CERT=
VAULT_NGINX_KEY=
# NGINX 直连后端的 HTTP(S) Origin，不含网关路径或末尾斜杠。
VAULT_NGINX_API_TARGET=
# 可选：直接运行 HTTPS 开发服务时使用的证书和私钥路径。
VAULT_DEV_CERT=
VAULT_DEV_KEY=

# 自动锁定时限：无操作（分钟）/ 后台停留（秒），均须为正整数。
# 留空使用默认值：开发环境 1 分钟 / 20 秒，生产环境 5 分钟 / 60 秒。
VAULT_IDLE_LOCK_MINUTES=
VAULT_BACKGROUND_LOCK_SECONDS=
