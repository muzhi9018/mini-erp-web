# 复制为 .env.local，真实地址仅填写在被 Git 忽略的文件或 CI 环境变量中。
# 开发环境后端基础地址，按需包含网关路径。
DEV_API_BASE_URL=
# 生产环境后端基础地址，显式留空表示使用同源请求。
API_BASE_URL=
# 聊天接口地址，按需配置。
CHAT_API_URL=
# 开发环境和生产环境的独立密码库站点地址，必须使用 HTTPS。
DEV_VAULT_SITE_URL=
VAULT_SITE_URL=
# start:test 和 start:pre 使用的开发代理目标，按需配置。
TEST_API_PROXY_TARGET=
PRE_API_PROXY_TARGET=
# 可选的开发客户端标识与授权值。前端配置不是秘密存储，禁止填写服务端秘密。
DEV_CLIENT_ID=
DEV_CLIENT_BASIC_TOKEN=
# 可选的 Google Analytics ID；留空时关闭统计。
ANALYTICS_ID=
